{
  "name": "goort",
  "version": "1.0.1",
  "type": "module",
  "description": "a nodejs-based Virtual Runtime for S7 PLC CPU.",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "goohmi": "workspace:^",
    "goovplc": "workspace:^"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.52.4",
    "mri": "^1.2.0",
    "rimraf": "^6.0.1",
    "yaml": "^2.8.1"
  },
  "directories": {
    "lib": "lib"
  },
  "bin": {
    "vplc": "./cli.js"
  },
  "scripts": {
    "clean": "rimraf ./lib",
    "dev": "nodemon ./dev.js",
    "start": "node ./cli.js",
    "build": "rollup -c",
    "watch": "rollup -c -w"
  },
  "keywords": [
    "PLC",
    "S7",
    "SCADA",
    "nodejs"
  ],
  "author": "goosy.jo@gmail.com",
  "license": "MIT"
}